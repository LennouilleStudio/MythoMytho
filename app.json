{
  "expo": {
    "name": "MythoMytho",
    "slug": "mythomytho",
    "scheme": "mythomytho",
    "version": "2.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "icon": "./assets/images/favicon-512.png",
    "backgroundColor": "#0e1613",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "fr.lennouille.mythomytho"
    },
    "android": {
      "package": "fr.lennouille.mythomytho",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/favicon-maskable-512.png",
        "backgroundColor": "#0e1613"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon-192.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0e1613",
          "image": "./assets/images/splash.png",
          "imageWidth": 260,
          "resizeMode": "contain"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}